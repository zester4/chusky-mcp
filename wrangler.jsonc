{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "chusky-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 0.2 },
  // OAuth requires an account-specific KV namespace. Add the returned ID from
  // `wrangler kv namespace create CHUSKY_MCP_OAUTH` before deploying OAuth.
  // "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "<namespace-id>" }],
  "vars": {
    "CHUSKY_API_ORIGIN": "https://chusky.up.railway.app"
  }
}
